# SPDX-License-Identifier: MIT OR Apache-2.0
# P4-001a test unit (ADR-035): inspects one package from the CAS, as a
# throwaway user, without network, on a read-only file system.

[Unit]
Description=Pakomichi package inspector instance (P4-001a test)

[Service]
Type=exec
DynamicUser=yes
SupplementaryGroups=pakomichi
ExecStart=/usr/local/bin/pakomichi-inspector --cas-root /var/lib/pakomichi/cas --socket /run/pakomichi/inspect.sock
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=120
NoNewPrivileges=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/lib/pakomichi/cas
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
UMask=0077
