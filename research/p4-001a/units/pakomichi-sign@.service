# SPDX-License-Identifier: MIT OR Apache-2.0
# P4-001a test unit (ADR-035): signs one Release with the local metadata
# key, which only this user can read.

[Unit]
Description=Pakomichi metadata signer instance (P4-001a test)

[Service]
Type=exec
User=pakomichi-signer
Group=pakomichi-signer
EnvironmentFile=/etc/pakomichi/signer.env
ExecStart=/usr/local/bin/pakomichi-signer --homedir /var/lib/pakomichi-signer/gnupg --key ${KEY} --socket /run/pakomichi/sign.sock
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=120
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/pakomichi-signer
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
UMask=0077
