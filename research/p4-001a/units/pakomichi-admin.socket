# SPDX-License-Identifier: MIT OR Apache-2.0
# P4-001a test unit (ADR-029 point 2): administrative requests, root only.
# The state owner checks the peer again from SO_PEERCRED.

[Unit]
Description=Pakomichi administrative socket (P4-001a test)

[Socket]
ListenStream=/run/pakomichi/admin.sock
SocketUser=root
SocketMode=0600
FileDescriptorName=admin
Service=pakomichi-state.service

[Install]
WantedBy=sockets.target
