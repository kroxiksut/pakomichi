# SPDX-License-Identifier: MIT OR Apache-2.0
# P2-013b test unit (ADR-035): one signer instance per connection. Only
# the state owner's user may open the socket; the instance checks the peer
# again from SO_PEERCRED.

[Unit]
Description=Pakomichi metadata signer socket (P2-013b test)

[Socket]
ListenStream=/run/pakomichi/sign.sock
SocketUser=pakomichi
SocketMode=0600
Accept=yes
MaxConnections=4

[Install]
WantedBy=sockets.target
