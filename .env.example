# Template for local development and isolated research environments.
# Copy to .env and keep real values out of Git. Nothing loads this file
# automatically until the project defines a bootstrap workflow.

# VM/container selection. Record the exact image digest in the R report.
PAKOMICHI_VM_PROVIDER=manual
PAKOMICHI_VM_IMAGE=

# Optional SSH access to an isolated VM. Prefer a dedicated lab key.
PAKOMICHI_VM_SSH_HOST=
PAKOMICHI_VM_SSH_PORT=22
PAKOMICHI_VM_SSH_USER=
PAKOMICHI_VM_SSH_KEY=

# Optional API token for controlled GitHub research. Use minimum scope.
# PAKOMICHI_GITHUB_TOKEN=

# Raw logs and VM state stay local; publish only sanitized evidence.
PAKOMICHI_RESEARCH_LOCAL=.research-local
PAKOMICHI_VM_LOCAL=.vm-local
